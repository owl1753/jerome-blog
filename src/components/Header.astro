<header class="header">
  <div class="header-container">
    <a href="/" class="logo">Jerome's Blog</a>
    <nav class="nav">
      <a href="/about" class="nav-link">소개</a>
      <a href="/blog" class="nav-link">블로그</a>
    </nav>
  </div>
</header>

<style>
  .header {
    display: flex;
    height: 80px;
    justify-content: center;
    align-items: center;
    gap: 10px;
    align-self: stretch;
  }

  .header-container {
    display: flex;
    max-width: 1240px;
    padding: 0 20px;
    width: 100%;
    justify-content: space-between;
    align-items: center;
    align-self: stretch;
  }

  .logo {
    color: var(--text-primary);
    font-family: var(--font-pretendard);
    font-size: 24px;
    font-style: normal;
    font-weight: 700;
    line-height: normal;
    text-decoration: none;
  }

  .nav {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 32px;
  }

  .nav-link {
    color: var(--text-primary);
    font-family: var(--font-pretendard);
    font-size: 16px;
    font-style: normal;
    font-weight: 500;
    line-height: normal;
    text-decoration: none;
  }
</style>
