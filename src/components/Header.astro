---
const currentPathname = Astro.url.pathname;
const links = [
  {
    title: "소개",
    href: "/about",
  },
  {
    title: "블로그",
    href: "/blog",
  },
] as const;
---

<header class="header">
  <div class="header-container">
    <a href="/" class="logo">Jerome's Blog</a>
    <nav class="nav">
      {
        links.map(({ title, href }) => (
          <a
            href={href}
            class:list={["nav-link", { active: currentPathname == href }]}
          >
            {title}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<style>
  .header {
    display: flex;
    height: 80px;
    justify-content: center;
    align-items: center;
    gap: 10px;
    align-self: stretch;
  }

  .header-container {
    display: flex;
    max-width: 1240px;
    padding: 0 20px;
    width: 100%;
    justify-content: space-between;
    align-items: center;
    align-self: stretch;
  }

  .logo {
    color: var(--text-primary);
    font-family: var(--font-pretendard);
    font-size: 24px;
    font-style: normal;
    font-weight: 700;
    line-height: normal;
    text-decoration: none;
  }

  .nav {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 32px;
  }

  .nav-link {
    color: var(--text-primary);
    font-family: var(--font-pretendard);
    font-size: 16px;
    font-style: normal;
    font-weight: 500;
    line-height: normal;
    text-decoration: none;
  }

  .nav-link.active {
    color: var(--brand-primary);
  }
</style>
