---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import { getImage } from "astro:assets";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const fallbackCategory = "카테고리";
---

<Layout>
  <main class="blog-page">
    <section class="blog-list-section">
      <div class="blog-list-container">
        {
          posts.length > 0 ? (
            <div class="post-list">
              {posts.map(async (post) => {
                const image = await getImage({ src: post.data.cover });
                return (
                  <a class="post-list-link" href={`/blog/${post.id}`}>
                    <article class="post-list-item">
                      <div
                        style={`background-image: url(${image.src})`}
                        class="post-list-thumbnail"
                      />

                      <div class="post-list-content">
                        <div class="post-list-text-group">
                          <span class="post-list-category">
                            {fallbackCategory}
                          </span>
                          <div class="post-list-title-group">
                            <h2 class="post-list-title">{post.data.title}</h2>
                            <p class="post-list-description">
                              {post.data.description}
                            </p>
                          </div>
                        </div>

                        <time
                          class="post-list-date"
                          datetime={post.data.pubDate.toISOString()}
                        >
                          {post.data.pubDate.toLocaleDateString("ko-KR")}
                        </time>
                      </div>
                    </article>
                  </a>
                );
              })}
            </div>
          ) : (
            <p class="empty-message">아직 작성된 글이 없습니다.</p>
          )
        }
      </div>
    </section>
  </main>
</Layout>

<style>
  .blog-page {
    display: flex;
    justify-content: center;
    align-items: flex-start;
  }

  .blog-list-section {
    display: flex;
    justify-content: center;
    width: 100%;
    padding: 60px 0 96px;
  }

  .blog-list-container {
    display: flex;
    width: 100%;
    max-width: 1240px;
    padding: 0 20px;
    flex-direction: column;
  }

  .post-list {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .post-list-link {
    display: block;
    text-decoration: none;
  }

  .post-list-item {
    display: flex;
    align-items: stretch;
    gap: 16px;
    border-radius: 16px;
    background: var(--bg-default);
    box-shadow: 0 4px 12px 0 rgba(0, 0, 0, 0.08);
    overflow: hidden;
  }

  .post-list-link:focus-visible {
    outline: 2px solid var(--brand-primary);
    outline-offset: 4px;
    border-radius: 8px;
  }

  .post-list-thumbnail {
    width: 340px;
    height: 200px;
    flex-shrink: 0;
    background-size: cover;
    background-position: center;
  }

  .post-list-content {
    display: flex;
    height: 200px;
    min-width: 0;
    flex: 1;
    padding: 24px;
    flex-direction: column;
    justify-content: space-between;
    align-items: flex-start;
    gap: 24px;
  }

  .post-list-text-group,
  .post-list-title-group {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .post-list-text-group {
    gap: 16px;
  }

  .post-list-title-group {
    gap: 8px;
  }

  .post-list-category {
    color: var(--brand-secondary);
    font-family: var(--font-pretendard);
    font-size: 14px;
    font-style: normal;
    font-weight: 500;
    line-height: normal;
  }

  .post-list-title {
    color: var(--text-primary);
    font-family: var(--font-pretendard);
    font-size: 24px;
    font-style: normal;
    font-weight: 700;
    line-height: normal;
  }

  .post-list-description {
    color: var(--text-secondary);
    font-family: Pretendard;
    font-size: 16px;
    font-style: normal;
    font-weight: 400;
    line-height: normal;
    overflow: hidden;
    text-overflow: ellipsis;
    word-break: break-word;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }

  .post-list-date,
  .empty-message {
    color: var(--text-tertiary);
    font-family: Pretendard;
    font-size: 14px;
    font-style: normal;
    font-weight: 500;
    line-height: normal;
  }

  .post-list-date {
    white-space: nowrap;
  }

  .empty-message {
    padding: 40px 0;
    text-align: center;
  }

  @media (max-width: 720px) {
    .blog-list-section {
      padding: 40px 0 72px;
    }

    .post-list-item {
      flex-direction: column;
    }

    .post-list-thumbnail {
      width: 100%;
      height: 200px;
    }

    .post-list-content {
      height: 190px;
    }
  }
</style>
