---
import { getCollection } from "astro:content";
import Button from "../components/Button.astro";
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";

const posts = await getCollection("blog");
---

<Layout>
  <section class="hero-section">
    <div class="hero-section-container">
      <div class="hero-section-body">
        <div class="hero-section-text-group">
          <h1 class="hero-section-headline">Software Engineer</h1>
          <p class="hero-section-description">
            문제 해결에 몰입하는 소프트웨어 엔지니어, 심민성입니다.
          </p>
        </div>
        <div class="here-section-button-group">
          <a class="hero-section-link" href="/about">
            <Button>소개 보기</Button>
          </a>
        </div>
      </div>
    </div>
  </section>
  <section class="recent-posts-section">
    <div class="recent-posts-container">
      <h2 class="recent-posts-title">Recent Posts</h2>
      <div class="recent-posts-post-list">
        {
          posts.map((post) => (
            <a class="post-card-link" href={`/blog/${post.id}`}>
              <div class="post-card-container">
                <div class="post-card-thumbnail">
                  <Image src={post.data.cover} alt={post.data.coverAlt} />
                </div>
                <div class="post-card-content">
                  <div class="post-card-text-group">
                    <span class="post-card-category">카테고리</span>
                    <div class="post-card-content-group">
                      <h3 class="post-card-title">{post.data.title}</h3>
                      <p class="post-card-description">
                        {post.data.description}
                      </p>
                    </div>
                  </div>
                  <span class="post-card-date">
                    {post.data.pubDate.toLocaleDateString("ko-KR")}
                  </span>
                </div>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero-section {
    display: flex;
    padding: 120px 0;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 10px;
    align-self: stretch;
  }

  .hero-section-container {
    display: flex;
    max-width: 1240px;
    width: 100%;
    padding: 0 20px;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
  }

  .hero-section-body {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    gap: 32px;
  }

  .hero-section-text-group {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    align-self: stretch;
  }

  .hero-section-headline {
    color: var(--text-primary);
    font-family: var(--font-pretendard);
    font-size: 56px;
    font-style: normal;
    font-weight: 700;
    line-height: normal;
  }

  .hero-section-description {
    color: var(--text-secondary);
    font-family: var(--font-pretendard);
    font-size: 24px;
    font-style: normal;
    font-weight: 400;
    line-height: 32px; /* 133.333% */
  }

  .hero-section-button-group {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .hero-section-link {
    text-decoration: none;
  }

  .recent-posts-section {
    display: flex;
    padding: 60px 0;
    justify-content: center;
    align-items: flex-start;
    gap: 10px;
    align-self: stretch;
  }

  .recent-posts-container {
    display: flex;
    max-width: 1240px;
    width: 100%;
    padding: 20px;
    flex-direction: column;
    align-items: flex-start;
    gap: 24px;
  }

  .recent-posts-post-list {
    display: flex;
    padding-bottom: 40px;
    width: 100%;
    align-items: flex-start;
    gap: 32px;
    overflow: auto;
  }

  .post-card-container {
    display: flex;
    width: 340px;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
    flex-shrink: 0;

    border-radius: 16px;
    background: var(--bg-default);
    box-shadow: 0 4px 12px 0 rgba(0, 0, 0, 0.08);
  }

  .post-card-thumbnail {
    width: 100%;
    height: 200px;
    align-self: stretch;
  }

  .post-card-content {
    display: flex;
    height: 190px;
    padding: 24px;
    flex-direction: column;
    justify-content: space-between;
    align-items: flex-start;
    align-self: stretch;
  }

  .post-card-text-group {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
    align-self: stretch;
  }

  .post-card-content-group {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
  }

  .post-card-title {
    color: var(--text-primary);
    font-family: var(--font-pretendard);
    font-size: 24px;
    font-style: normal;
    font-weight: 700;
    line-height: normal;
  }

  .post-card-category {
    color: var(--brand-secondary);
    font-family: var(--font-pretendard);
    font-size: 14px;
    font-style: normal;
    font-weight: 500;
    line-height: normal;
  }

  .post-card-link {
    text-decoration: none;
  }

  .post-card-description {
    color: var(--text-secondary);
    font-family: Pretendard;
    font-size: 16px;
    font-style: normal;
    font-weight: 400;
    line-height: normal;

    text-overflow: ellipsis;
    overflow: hidden;
    word-break: break-word;

    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }

  .post-card-date {
    color: var(--text-tertiary);
    font-family: Pretendard;
    font-size: 14px;
    font-style: normal;
    font-weight: 500;
    line-height: normal;
  }
</style>
